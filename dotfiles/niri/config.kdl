// ════════════════════════════════════════════════════════════════════════
// niri 主配置(在仓库里直接编辑,保存即生效)
//
// 这个文件不经过 Nix store:
//   ~/.config/niri/config.kdl  →  本文件(软链,见 home/jiro/niri.nix)
// 所以平时改键位/设置,直接改这里并保存,niri 会立刻热重载,
// 不需要 `nh home switch`。
//
// 只有这两种情况才需要 rebuild:
//   - 改 base.kdl 的生成规则(home/jiro/niri.nix 里的 sed)
//   - 增删软件包
//
// 如果编辑器用「原子保存」(写临时文件再改名)导致 niri 没反应,
// 手动让它重载:
//   niri msg action load-config-file
// ════════════════════════════════════════════════════════════════════════

// 默认值(键位、输入、动画、布局规则)来自 niri 自带的 default-config.kdl,
// 由 home/jiro/niri.nix 在构建时生成到 ~/.config/niri/base.kdl。
//
// include 是「位置相关」的:同一项设置,写在 include 之后才会覆盖默认值。
include "~/.config/niri/base.kdl"

// noctalia:状态栏 + 启动器 + 通知中心 + 控制中心一体的 Wayland 外壳
spawn-at-startup "noctalia"

// ── 个人设置写在这下面 ──────────────────────────────────────────────────
// 例:覆盖默认的终端快捷键
// Mod+T { spawn "kitty"; }
//
// 例:窗口间隙
// layout {
//     gaps 8
// }

// ── 截屏 ────────────────────────────────────────────────────────────────
// niri 自带截图功能(不依赖 grim / spectacle / portal),默认配置里已经绑了:
//   Print        → 截图 UI
//   Ctrl+Print   → 整屏直接截
//   Alt+Print    → 当前窗口直接截
// 但 75% 配列(如迈从 G75)没有独立 PrtSc 键,所以这里补一组 Mod+P:
//
//   Mod+P       → 截图 UI(拖拽选区 / 点窗口 / 直接回车 = 全屏)
//   Mod+Ctrl+P  → 直接截整屏
//   Mod+Alt+P   → 直接截当前窗口
//
// 为什么不用 Fn+Insert(它发出的是 Insert 键)去模拟 PrtSc:
//   Fn 层是键盘固件,系统只能看到最终的 Insert 键;把它改成 Print 等于
//   【永久放弃 Insert 键】(终端的插入/覆盖切换、Shift+Insert 粘贴等),
//   而且接外接键盘时同样生效。用 Mod+P 不牺牲任何键。
//   注意:Mod+Shift+P 已被 base.kdl 用作 power-off-monitors,所以这里用无/ Ctrl / Alt。
//
// 截图保存位置由 base.kdl 里的 screenshot-path 决定:
//   ~/Pictures/Screenshots/ptrScr-<日期>.png
// 同时会放进剪贴板。
//
// 注意:键位必须写在 binds { } 块里(和 base.kdl 里的同名块会合并)。
binds {
    // 截图
    Mod+P { screenshot; }
    Mod+Ctrl+P { screenshot-screen; }
    Mod+Alt+P { screenshot-window; }

    // 文件管理器。默认应用由 home/common/mime.nix 里的 inode/directory 决定。
    // xdg-open 必须给目标,所以这里就是“用默认文件管理器打开主目录”。
    // Mod+E hotkey-overlay-title="Open the default file manager" { spawn-sh "xdg-open \"$HOME\""; }
    // 浏览器。xdg-open 需要网址才能启动,所以直接启动 firefox(与 mime.nix 里的默认一致)。
    Mod+N hotkey-overlay-title="Open the default browser" { spawn "firefox"; }

    // niri默认音量调节步进为0.1,太大了，这里调小
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.04+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.04-"; }


    // 示例：绑定到 Ctrl+Alt+Delete
    Ctrl+Alt+Delete hotkey-overlay-title="会话菜单" { spawn "noctalia" "msg" "panel-toggle" "session"; }

    // 快捷键速查表(全部键位,见 dotfiles/niri/KEYS.md)。
    // 用 Mod+Slash 而不是 Mod+Shift+Slash:后者已被 base.kdl 用作 niri 自带的
    // 「重要快捷键」浮层,不能覆盖。两者互补 —— 浮层快,KEYS.md 全。
    // 用浮动 kitty + bat 显示,不依赖浏览器。
    Mod+Slash hotkey-overlay-title="Niri 快捷键速查" { spawn-sh "kitty --class niri-keys -T 'Niri 快捷键' -e bat --style=plain --paging=always \"$HOME/.config/niri/KEYS.md\""; }

    // 把下面的几个快捷键实际上默认已设置，这里重设只是为了加进hotkey菜单，
    // niri默认 Mod+Shift+/ 显示重要的hotkey菜单
    Mod+Minus hotkey-overlay-title="Adjust column width by -10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Adjust column width by 10%" { set-column-width "+10%"; }

    Mod+Comma hotkey-overlay-title="Consume one window from the right to the bottom of the focused column" { consume-window-into-column; }
    Mod+Period hotkey-overlay-title="Expel the bottom window from the focused column to the right" { expel-window-from-column; }

    Mod+Ctrl+R hotkey-overlay-title="Reset windows height" { reset-window-height; }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Switch preset windows height" { switch-preset-window-height; }

}

screenshot-path "~/Pictures/Screenshots/prtScr-%Y%m%d-%H%M%S.png"
layout {
    gaps 12
    focus-ring {
        on
        // active-color "#20af68"          // 换成你主题的 accent 色
        // inactive-color "#3b4261"
    }
    // 在第一个工作区上方保留一个空工作区，方便键盘操作
    empty-workspace-above-first
}

// 非焦点窗口整体降透明度，焦点窗口保持完全不透明 → 视差感最强
window-rule {
    match is-focused=false
    opacity 0.8
}

// 速查表窗口(Mod+Slash):浮动 + 固定占屏比例
window-rule {
    match app-id=r#"^niri-keys$"#
    open-floating true
    default-column-width { proportion 0.62; }
    default-window-height { proportion 0.8; }
}

animations {
       // Slow down all animations by this factor. Values below 1 speed them up instead.
    slowdown 1.2
}
