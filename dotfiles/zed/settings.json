{
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        },
        "delete_path": {
          "always_allow": [
            {
              "pattern": "^nixos-config/docs/"
            }
          ]
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            },
            {
              "pattern": "^https?://api\\.github\\.com"
            },
            {
              "pattern": "^https?://wiki\\.nixos\\.org"
            }
          ]
        }
      }
    },
    "auto_compact": {
      "enabled": true,
      "threshold": 250000
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "model": "deepseek-flash",
      "provider": "deepseek"
    },
    "default_profile": "write",
    "show_turn_stats": true,
    "single_file_review": true
  },
  "markdown_preview": {
    "open_markdown_files_in_preview": true
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_size": 15,
  "agent_buffer_font_size": 15,
  "agent_ui_font_size": 16.0,
  "helix_mode": true,
  "cli_default_open_behavior": "new_window",
  "default_open_behavior": "new_window",
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "completions": {
    "lsp": true,
    "lsp_fetch_timeout_ms": 3000,
    "words": "enabled",
    "words_min_length": 2
  },
  "language_models": {
    "openai_compatible": {
      "ZhipuAI": {
        "api_url": "https://open.bigmodel.cn/api/paas/v4",
        "available_models": [
          {
            "name": "glm-5.3-flash",
            "display_name": "GLM-5.3-Flash",
            "max_tokens": 1048576,
            "max_output_tokens": 32768,
            "reasoning_effort": "high",
            "capabilities": {
              "prompt_cache_key": true,
              "tools": true,
              "images": true,
              "parallel_tool_calls": true
            }
          },
          {
            "name": "glm-4.7-flash",
            "display_name": "GLM-4.7-Flash (free)",
            "max_tokens": 200000,
            "max_output_tokens": 30000,
            "capabilities": {
              "prompt_cache_key": true,
              "tools": true,
              "images": false,
              "parallel_tool_calls": false
            }
          }
        ]
      }
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "nix": true,
    "toml": true,
    "typst": true
  },
  "format_on_save": "on",
  "languages": {
    "Markdown": {
      "format_on_save": "on"
    },
    "Nix": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt"
        }
      },
      "language_servers": [
        "nixd",
        "!nil"
      ]
    },
    "Python": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      },
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "language_servers": [
        "pyright",
        "ruff"
      ],
      "preferred_line_length": 100,
      "tab_size": 4
    },
    "Rust": {
      "format_on_save": "on",
      "language_servers": [
        "rust-analyzer"
      ],
      "tab_size": 4
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "diagnostic": {
          "suppress": [
            "sema-extra-with"
          ]
        },
        "nixpkgs": {
          "expr": "import (builtins.getFlake \"/home/jiro/nixos-config\").inputs.nixpkgs { }"
        },
        "options": {
          "home-manager": {
            "expr": "(builtins.getFlake \"/home/jiro/nixos-config\").homeConfigurations.\"jiro@XPS9560\".options"
          },
          "nixos": {
            "expr": "(builtins.getFlake \"/home/jiro/nixos-config\").nixosConfigurations.XPS9560.options"
          }
        }
      }
    }
  },
  "terminal": {
    "shell": {
      "program": "/nix/store/vky57s95n7hrqarlqdndp1h5m0mgdnw5-fish-4.7.1/bin/fish"
    }
  }
}
