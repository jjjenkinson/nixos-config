{
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_size": 15,
  "agent_buffer_font_size": 15,
  "agent_ui_font_size": 16.0,
  "helix_mode": true,
  "cli_default_open_behavior": "new_window",
  "default_open_behavior": "new_window",
  "edit_prediction_provider": "zed",
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "completions": {
    "lsp": true,
    "lsp_fetch_timeout_ms": 3000,
    "words": "enabled",
    "words_min_length": 2
  },
  "agent": {
    "default_model": {
      "provider": "openai_compatible",
      "model": "glm-5.3-flash",
      "effort": "high",
      "enable_thinking": true
    },
    "auto_compact": {
      "enable": true,
      "threshold": "60%"
    },
    "default_profile": "write",
    "favorite_models": [],
    "project_context": "none",
    "include_active_editor_context": false,
    "single_file_review": true,
    "tool_permissions": {
      "tools": {
        "delete_path": {
          "always_allow": [
            {
              "pattern": "^nixos-config/docs/"
            }
          ]
        },
        "terminal": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            },
            {
              "pattern": "^https?://api\\.github\\.com"
            },
            {
              "pattern": "^https?://wiki\\.nixos\\.org"
            },
            {
              "pattern": "^https?://flathub\\.org"
            },
            {
              "pattern": "^https?://mangowm\\.github\\.io"
            }
          ]
        }
      }
    }
  },
  "language_models": {
    "openai_compatible": {
      "ZhipuAI": {
        "api_url": "https://open.bigmodel.cn/api/paas/v4",
        "available_models": [
          {
            "name": "glm-5.3-flash",
            "display_name": "GLM-5.3-Flash",
            "max_tokens": 1048576,
            "max_output_tokens": 32000,
            "stream": true,
            "reasoning_effort": "high",
            "capabilities": {
              "prompt_cache_key": true,
              "tools": true,
              "images": true,
              "parallel_tool_calls": true
            }
          }
        ]
      }
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "nix": true,
    "toml": true,
    "typst": true
  },
  "format_on_save": "on",
  "languages": {
    "Markdown": {
      "format_on_save": "on",
      "markdown_preview": {
        "open_markdown_files_in_preview": true
      }
    },
    "Nix": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt"
        }
      },
      "language_servers": [
        "nixd",
        "!nil"
      ]
    },
    "Python": {
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.fixAll.ruff": true,
            "source.organizeImports.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ],
      "language_servers": [
        "pyright",
        "ruff"
      ],
      "preferred_line_length": 100,
      "tab_size": 4
    },
    "Rust": {
      "format_on_save": "on",
      "language_servers": [
        "rust-analyzer"
      ],
      "tab_size": 4
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "diagnostic": {
          "suppress": [
            "sema-extra-with"
          ]
        },
        "nixpkgs": {
          "expr": "import (builtins.getFlake \"/home/jiro/nixos-config\").inputs.nixpkgs { }"
        },
        "options": {
          "home-manager": {
            "expr": "(builtins.getFlake \"/home/jiro/nixos-config\").homeConfigurations.\"jiro@XPS9560\".options"
          },
          "nixos": {
            "expr": "(builtins.getFlake \"/home/jiro/nixos-config\").nixosConfigurations.XPS9560.options"
          }
        }
      }
    }
  },
  "terminal": {
    "shell": {
      "program": "/nix/store/vky57s95n7hrqarlqdndp1h5m0mgdnw5-fish-4.7.1/bin/fish"
    }
  }
}
